Options -Indexes

# Evitar que navegador o proxy conserve versiones antiguas de la aplicación.
<IfModule mod_headers.c>
  <FilesMatch "^(index\\.html|sw\\.js|manifest\\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /Tarjetas-transferencias/

# API routes handled by PHP
RewriteRule ^api/?$ api/index.php?path= [QSA,L]
RewriteRule ^api/(.*)$ api/index.php?path=$1 [QSA,L]

# Las rutas públicas de tarjetas deben cargar la SPA aunque exista una carpeta física /t.
RewriteRule ^t/[A-Za-z0-9_-]+/?$ index.html [L]
RewriteRule ^pagos/[A-Za-z0-9_-]+/?$ index.html [L]

# Keep real files and directories accessible
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Public card links and React SPA fallback
RewriteRule ^ index.html [L]
